{
  "name": "questling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "node scripts/gen-privacy.mjs && nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt prepare && nuxt typecheck",
    "lint": "nuxt prepare && eslint .",
    "lint:fix": "nuxt prepare && eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run generate && cap sync android",
    "cap:android": "cap open android",
    "e2e": "npm run generate:e2e && playwright test",
    "e2e:only": "playwright test",
    "icons": "node scripts/gen-app-icons.mjs",
    "test:rules": "node scripts/with-emulators.mjs vitest run -c vitest.rules.config.ts",
    "privacy": "node scripts/gen-privacy.mjs",
    "e2e:cloud": "node scripts/with-emulators.mjs node scripts/e2e-cloud.mjs",
    "generate:e2e": "node scripts/gen-privacy.mjs && nuxt generate --dotenv .env.e2e"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "firebase-tools": "^15.34.2",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@iconify-json/lucide": "^1.2.151",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "firebase": "^12.19.0",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "engines": {
    "node": ">=22.21.0"
  }
}
