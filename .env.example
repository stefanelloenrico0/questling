# Account e sincronizzazione (opzionali). Senza queste variabili Questling funziona solo in locale.
# Si trovano in Firebase Console > Impostazioni progetto > Le tue app > App web (SDK config).
# Vedi docs/firebase-setup.md
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
